{
  "name": "OpenCode REPL Tools Demo",
  "image": "ghcr.io/mdc-git/opencode-repl-tools-demo:demo",
  "remoteUser": "root",
  "forwardPorts": [7681],
  "portsAttributes": {
    "7681": {
      "label": "OpenCode TUI",
      "onAutoForward": "silent"
    }
  },
  "postStartCommand": "bash .devcontainer/start-demo.sh",
  "postAttachCommand": "bash .devcontainer/publish-demo.sh"
}

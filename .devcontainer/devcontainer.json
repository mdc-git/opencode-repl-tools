{
  "name": "OpenCode REPL Tools Demo Controller",
  "image": "ghcr.io/mdc-git/opencode-repl-tools-demo:controller",
  "remoteUser": "root",
  "runArgs": ["--network=host"],
  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"],
  "forwardPorts": [7681],
  "portsAttributes": {
    "7681": {
      "label": "OpenCode TUI",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "postStartCommand": "mkdir -p \"$HOME/.cache\" && setsid --fork /usr/local/bin/start-demo-sandbox </dev/null >/dev/null 2>&1",
  "postAttachCommand": "/usr/local/bin/publish-demo"
}

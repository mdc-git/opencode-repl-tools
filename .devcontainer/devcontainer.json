{
  "name": "OpenCode REPL Tools Demo Controller",
  "build": {
    "dockerfile": "controller.Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": true,
      "installDockerBuildx": false,
      "dockerDashComposeVersion": "none",
      "installDockerComposeSwitch": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode",
  "forwardPorts": [7681],
  "portsAttributes": {
    "7681": {
      "label": "OpenCode TUI",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "postStartCommand": "/usr/local/bin/start-demo-sandbox && nohup /usr/local/bin/publish-demo </dev/null >>$HOME/.cache/opencode-repl-tools-preview.log 2>&1 &"
}

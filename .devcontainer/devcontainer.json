{
  "name": "OpenCode REPL Tools Preview",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26"
    }
  },
  "forwardPorts": [7681],
  "portsAttributes": {
    "7681": {
      "label": "OpenCode TUI",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y python3 python3-venv python3-pip ttyd && npm install --global bun @opencode/cli@beta && bun install",
  "postStartCommand": "nohup ttyd --writable --interface 0.0.0.0 --port 7681 --cwd \"${containerWorkspaceFolder}\" opencode2 --standalone \"${containerWorkspaceFolder}\" >/dev/null 2>&1 </dev/null &"
}

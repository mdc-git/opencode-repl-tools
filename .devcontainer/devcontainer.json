{
  "name": "OpenCode REPL Tools Demo",
  "forwardPorts": [7681],
  "portsAttributes": {
    "7681": {
      "label": "OpenCode TUI",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "onCreateCommand": "bash .devcontainer/prepare-demo.sh",
  "updateContentCommand": "npm install --omit=dev --ignore-scripts --no-package-lock --no-audit --no-fund",
  "postStartCommand": "bash .devcontainer/start-demo.sh"
}
